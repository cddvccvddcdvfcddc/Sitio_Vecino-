# Variables del servidor. Se leen del entorno o de un archivo ".env" en esta carpeta.
PORT=4173
HOST=127.0.0.1
# Al publicar detrás de HTTPS configura el origen exacto (sin barra final):
# PUBLIC_ORIGIN=https://tu-dominio-real
# DATA_DIR debe ser una carpeta privada y persistente del servidor.
# Aviso por correo de cada solicitud (Gmail). Copia este archivo como ".env" y completa:
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=contraseña de aplicación de 16 letras (no tu contraseña normal)
# NOTIFY_TO=correo que recibe los avisos (opcional; por defecto, SMTP_USER)
